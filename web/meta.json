{
  "title": "Heart Disease Risk Predictor",
  "subtitle": "Estimates the chance of coronary heart disease from 13 routine clinical measurements, using the classic UCI Cleveland patient data.",
  "tags": [
    "Classification",
    "scikit-learn",
    "Logistic Regression",
    "Decision Tree",
    "Nested CV",
    "ONNX"
  ],
  "task": "classification",
  "classes": [
    0,
    1
  ],
  "positive_class": 1,
  "output_label": "Estimated probability of heart disease",
  "verdicts": [
    "Low estimated risk",
    "Moderate estimated risk",
    "High estimated risk"
  ],
  "thresholds": [
    0.3,
    0.6
  ],
  "result_note": "<b>Not medical advice.</b> This is a learning project trained on 303 patients from a 1988 study; it cannot diagnose anyone. If you have heart symptoms, see a doctor.",
  "features": [
    {
      "name": "age",
      "label": "Age",
      "help": "years",
      "type": "number",
      "min": 29.0,
      "max": 77.0,
      "step": 1,
      "default": 55
    },
    {
      "name": "sex",
      "label": "Sex",
      "type": "category",
      "options": [
        "Female",
        "Male"
      ],
      "default": "Male"
    },
    {
      "name": "chest_pain",
      "label": "Chest pain type",
      "type": "category",
      "options": [
        "Asymptomatic",
        "Atypical angina",
        "Non-anginal pain",
        "Typical angina"
      ],
      "default": "Asymptomatic"
    },
    {
      "name": "resting_bp",
      "label": "Resting blood pressure",
      "help": "mm Hg",
      "type": "number",
      "min": 94.0,
      "max": 200.0,
      "step": 1,
      "default": 130
    },
    {
      "name": "cholesterol",
      "label": "Serum cholesterol",
      "help": "mg/dl",
      "type": "number",
      "min": 126.0,
      "max": 564.0,
      "step": 1,
      "default": 244
    },
    {
      "name": "high_fasting_sugar",
      "label": "Fasting blood sugar > 120 mg/dl",
      "type": "category",
      "options": [
        "No",
        "Yes"
      ],
      "default": "No"
    },
    {
      "name": "rest_ecg",
      "label": "Resting ECG",
      "type": "category",
      "options": [
        "Left ventricular hypertrophy",
        "Normal",
        "ST-T wave abnormality"
      ],
      "default": "Normal"
    },
    {
      "name": "max_heart_rate",
      "label": "Max heart rate (exercise test)",
      "help": "bpm",
      "type": "number",
      "min": 88.0,
      "max": 202.0,
      "step": 1,
      "default": 152
    },
    {
      "name": "exercise_angina",
      "label": "Chest pain during exercise",
      "type": "category",
      "options": [
        "No",
        "Yes"
      ],
      "default": "No"
    },
    {
      "name": "st_depression",
      "label": "ST depression",
      "help": "mm, exercise vs rest",
      "type": "number",
      "min": 0.0,
      "max": 6.2,
      "step": "any",
      "default": 0.8
    },
    {
      "name": "st_slope",
      "label": "ST segment slope (peak exercise)",
      "type": "category",
      "options": [
        "Downsloping",
        "Flat",
        "Upsloping"
      ],
      "default": "Flat"
    },
    {
      "name": "major_vessels",
      "label": "Major vessels seen on fluoroscopy",
      "help": "0\u20133",
      "type": "category",
      "options": [
        "0",
        "1",
        "2",
        "3"
      ],
      "default": "0"
    },
    {
      "name": "thallium_test",
      "label": "Thallium stress test",
      "type": "category",
      "options": [
        "Fixed defect",
        "Normal",
        "Reversible defect"
      ],
      "default": "Normal"
    }
  ],
